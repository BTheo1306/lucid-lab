        "jsCode": "const files = [{\"fileId\": \"1i_Valeghu7a8Ko6f7nUTVrMRq3xpPPtW\", \"filename\": \"Fiche d'inscription.docx\"}, {\"fileId\": \"1KTf4SxUXV87MhMMr1WVVMSerl1ZOQP_l\", \"filename\": \"Accords financiers.pdf\"}, {\"fileId\": \"1NsHMtQWMd6naRry1RiaHw4NNK3ME7Ifl\", \"filename\": \"Autorisation de quitter avec un tiers.docx\"}, {\"fileId\": \"1WabzzI7Nu_TtqjaSqTYeVLhRQbD051su\", \"filename\": \"Documents et materiel a fournir.pdf\"}, {\"fileId\": \"1iWPfMyRQrFozl38EeA8ylyh2Bvkm_yrT\", \"filename\": \"Reglement d'ordre interieur.pdf\"}, {\"fileId\": \"1vcnv6RvEH5pKK8QqjHxATu2EzNSvjLiu\", \"filename\": \"Familiarisation.pdf\"}, {\"fileId\": \"1CJLCFcs8_LDL-of_tt3RjyT1I-VzfxyY\", \"filename\": \"Familiarisation en douceur.pdf\"}, {\"fileId\": \"1RdohIzwiOZHQ7y4q5otDcd_pLfR1Q6IE\", \"filename\": \"Programme conges 2026.pdf\"}, {\"fileId\": \"1Duriclsis8cNj_Rz-sbPoc7wF0aHybIf\", \"filename\": \"Projet pedagogique.pdf\"}];\nreturn files.map(f => ({ json: { ...f, email_parent: $('Extraire le contact').item.json.email_parent } }));"
