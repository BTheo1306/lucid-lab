    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all(); const binary = {};\nitems.forEach((it, i) => { for (const k of Object.keys(it.binary || {})) binary[`piece_${i}_${k}`] = it.binary[k]; });\nreturn [{ json: {}, binary }];"
      },
      "id": "e80e2584-f7f3-424a-b5c4-5cee569866c8",
      "name": "Regrouper les binaires",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst item = $input.item; const bins = item.binary || {};\nconst content = []; let skipped = []; let totalBytes = 0;\nfor (const key of Object.keys(bins)) {\n  const b = bins[key]; const mime = (b.mimeType || '').toLowerCase();\n  const size = b.fileSize ? parseInt(b.fileSize) : (b.data ? b.data.length * 0.75 : 0);\n  totalBytes += size;\n  if (totalBytes > 25 * 1024 * 1024) { skipped.push(`${b.fileName} (limite de taille)`); continue; }\n  const data = b.data;\n  if (mime === 'application/pdf') content.push({ type: 'document', source: { type: 'base64', media_type: 'application/pdf', data } });\n  else if (['image/jpeg','image/png','image/webp','image/gif'].includes(mime)) content.push({ type: 'image', source: { type: 'base64', media_type: mime, data } });\n  else skipped.push(`${b.fileName || key} (format ${mime || 'inconnu'} non analysable)`);\n}\ncontent.push({ type: 'text', text: $('Paramètres').item.json.claude_prompt });\nreturn [{ json: { skipped, claude_request: { model: 'claude-sonnet-5', max_tokens: 2000, messages: [{ role: 'user', content }] },\n  email_parent: $('Chercher dans le pipeline').item.json['Email parent'],\n  row_number: $('Chercher dans le pipeline').item.json.row_number }, binary: bins }];\n"
      },
      "id": "36d44fff-b25e-4741-887a-898b0ec78e80",
      "name": "Préparer la requête Claude",
