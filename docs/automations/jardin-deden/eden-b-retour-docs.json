      "typeVersion": 2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.claude_request) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "9c1c312d-fdb0-4be4-bb01-3d7bf36c0f99",
      "name": "Claude : extraction du dossier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ],
      "credentials": {
        "anthropicApi": {
          "name": "Anthropic Lucid-Lab"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst resp = $input.item.json; let data;\ntry { const txt = (resp.content || []).map(c => c.text || '').join(''); data = JSON.parse(txt.replace(/^```json?\\s*|\\s*```$/g, '')); }\ncatch (e) { data = { enfant: {}, mere: {}, pere: {}, pieces: {}, anomalies: ['Extraction impossible : ' + e.message] }; }\nconst prev = $('Préparer la requête Claude').item.json;\nconst pieces = data.pieces || {};\nconst LIBELLES = { fiche_inscription: \"fiche d'inscription completee\", accords_financiers_signes: 'accords financiers signes',\n  autorisation_tiers: 'autorisation de sortie avec un tiers', ci_parent_1: \"carte d'identite du parent 1\",\n  ci_parent_2: \"carte d'identite du parent 2\", carte_assurance_sante: \"carte d'assurance sante\",\n  carnet_vaccination: 'carnet de vaccination', composition_menage: 'composition de menage' };\nconst manquantes = Object.keys(LIBELLES).filter(k => !pieces[k]).map(k => LIBELLES[k]);\nconst problemes = [...(data.anomalies || []), ...(prev.skipped || [])];\nconst e = data.enfant || {};\nif (!e.nom) problemes.push(\"Nom de l'enfant manquant\");\nif (!e.naissance) problemes.push('Date de naissance manquante');\nif (!e.entree) problemes.push(\"Date d'entree manquante\");\nlet entreeOK = false, section = '', ageEntreeMois = null;\nif (e.entree) {\n  const d = new Date(e.entree + 'T00:00:00'); entreeOK = d.getDate() === 1;\n  if (!entreeOK) problemes.push(`Date d'entree ${e.entree} : les entrees se font uniquement le 1er du mois`);\n  if (e.naissance) {\n    const n = new Date(e.naissance + 'T00:00:00');\n    ageEntreeMois = (d.getFullYear()-n.getFullYear())*12 + (d.getMonth()-n.getMonth()) - (d.getDate()<n.getDate()?1:0);\n    section = ageEntreeMois < 18 ? 'ET (etage)' : (ageEntreeMois <= 36 ? 'RE (rez)' : \"Trop age a l'entree !\");\n    if (ageEntreeMois > 36) problemes.push(\"Enfant de plus de 36 mois a la date d'entree\");\n  }\n}\nconst complet = manquantes.length === 0 && problemes.length === 0;\nconst nomFamille = [data.pere?.nom_prenom, data.mere?.nom_prenom].filter(Boolean).join(' / ');\nconst ligne = (l, v) => `<tr><td style=\"padding:2px 12px 2px 0;color:#666\">${l}</td><td><b>${v ?? '?'}</b></td></tr>`;\nconst recap = `<table style=\"border-collapse:collapse\">\n${ligne('Enfant', `${e.nom || '?'} ${e.prenom || ''}`)}\n${ligne('Naissance', e.naissance)}\n${ligne('Entree souhaitee', e.entree)}\n${ligne(\"Section a l'entree\", section || '?')}\n${ligne(\"Age a l'entree\", ageEntreeMois !== null ? ageEntreeMois + ' mois' : '?')}\n${ligne('Mere', `${data.mere?.nom_prenom || '?'} (${data.mere?.email || '?'})`)}\n${ligne('Pere', `${data.pere?.nom_prenom || '?'} (${data.pere?.email || '?'})`)}\n${ligne('Adresse', `${data.adresse || '?'} ${data.code_postal_ville || ''}`)}</table>`;\nconst listeHtml = arr => arr.length ? '<ul>' + arr.map(x => `<li>${x}</li>`).join('') + '</ul>' : '<p>aucun</p>';\nreturn [{ json: { extraction: data, complet, manquantes, problemes, section, ageEntreeMois,\n  nom_famille: nomFamille, recap_html: recap, manquantes_html: listeHtml(manquantes), problemes_html: listeHtml(problemes),\n  email_parent: prev.email_parent, row_number: prev.row_number }, binary: $input.item.binary }];\n"
      },
